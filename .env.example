[TEMPLATE]
# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string

# JWT Secret (used to sign admin session tokens)
JWT_SECRET=your_jwt_secret_key

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app

# Server Port (for local development only)
PORT=5000

# NOTE: Admin access is via one-line secret key.
# Add a document to the "adminkeys" MongoDB collection:
#   { "key": "your-one-line-secret-key", "label": "main", "isActive": true }
